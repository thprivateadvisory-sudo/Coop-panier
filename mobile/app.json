      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D5016"
      },
      "package": "fr.cooppanier.app",
      "versionCode": 9,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Coop'Panier utilise l'appareil photo pour scanner vos tickets de caisse et les QR codes bénéficiaires."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Coop'Panier accède à vos photos pour importer un ticket de caisse."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
