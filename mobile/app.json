{
  "expo": {
    "name": "Coop'Panier",
    "slug": "coop-panier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5016"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.cooppanier.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Coop'Panier utilise l'appareil photo pour scanner vos tickets de caisse.",
        "NSPhotoLibraryUsageDescription": "Coop'Panier accède à vos photos pour importer un ticket de caisse."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D5016"
      },
      "package": "fr.cooppanier.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-barcode-scanner",
      "expo-image-picker",
      "expo-notifications",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.fr.cooppanier"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "SUPABASE_URL_PLACEHOLDER",
      "supabaseAnonKey": "SUPABASE_ANON_KEY_PLACEHOLDER",
      "stripePublishableKey": "STRIPE_PUBLISHABLE_KEY_PLACEHOLDER",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
