{
  "expo": {
    "name": "Coop'Panier",
    "slug": "coop-panier",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25e9dcff-cc05-4342-8c0f-9bae6e4d07d4"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
